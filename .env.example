# Data-source API keys for the crowd-intelligence map.
# The MVP runs entirely on pre-computed / rule-based mock data and needs NONE
# of these. Add them as live sources are wired in. Copy to `.env.local`.

# --- Venues (bar/restaurant busyness, price, vibe) ---
# Google Popular Times is NOT exposed by the official Places API; we use
# BestTime.app for venue busyness curves (build-time only, in build:baselines).
BESTTIME_API_KEY=
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# --- Events (game schedule, attendance, sellout) ---
# NBA live JSON (cdn.nba.com) is keyless. Set NBA_GAME_ID to pin a specific
# game during a demo instead of auto-discovering today's Knicks game.
NBA_GAME_ID=
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=

# --- Subway (MTA ridership) ---
# Ridership comes from the keyless NY Open Data / Socrata dataset 5wq4-mkjj.
# SOCRATA_APP_TOKEN is optional and only raises rate limits.
SOCRATA_APP_TOKEN=
# MTA GTFS-RT feeds are public; key only needed for some endpoints.
MTA_API_KEY=

# --- Map basemap ---
# Using MapLibre GL + a free tile provider, so no token is required by default.
# Set this only if you switch to a keyed provider (Mapbox, MapTiler, etc.).
NEXT_PUBLIC_MAP_STYLE_URL=
