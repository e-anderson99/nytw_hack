# Data-source API keys for the crowd-intelligence map.
# The MVP runs entirely on pre-computed / rule-based mock data and needs NONE
# of these. Add them as live sources are wired in. Copy to `.env.local`.

# --- Venues (bar/restaurant busyness, price, vibe) ---
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# --- Events (game schedule, attendance, sellout) ---
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=

# --- Subway (real-time congestion) ---
# MTA GTFS-RT feeds are public; key only needed for some endpoints.
MTA_API_KEY=

# --- Map basemap ---
# Using MapLibre GL + a free tile provider, so no token is required by default.
# Set this only if you switch to a keyed provider (Mapbox, MapTiler, etc.).
NEXT_PUBLIC_MAP_STYLE_URL=
